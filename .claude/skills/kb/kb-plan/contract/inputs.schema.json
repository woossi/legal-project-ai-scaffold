{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/lp/contract/kb-plan-inputs.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$comment", "inBase", "structureContract", "files", "handlingRules"],
  "properties": {
    "$comment": {"$ref": "#/$defs/nonEmptyString"},
    "inBase": {"const": "output/legal"},
    "structureContract": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/fileRule"}
    },
    "handlingRules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    }
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "fileRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "handling"],
      "properties": {
        "role": {"$ref": "#/$defs/nonEmptyString"},
        "handling": {"$ref": "#/$defs/nonEmptyString"}
      }
    }
  }
}

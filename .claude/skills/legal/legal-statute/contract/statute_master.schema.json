{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "statute_master.json — 법령 정본 노드",
  "type": "object",
  "required": ["meta", "statutes"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["생성근거", "수집일", "API", "법령수", "검증상태분포", "원칙", "시행일_주의", "스크립트"],
      "properties": {
        "수집일": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "법령수": { "type": "integer", "minimum": 1 },
        "검증상태분포": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "statutes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "statute_key", "실측표기", "정식명칭", "약칭", "법령ID", "법령구분",
          "소관", "공포번호", "공포일자", "시행일자", "출처URL",
          "검증상태", "대조방법", "인용수", "인용용어수", "출현지구수",
          "인용조문", "표기변이수"
        ],
        "additionalProperties": false,
        "properties": {
          "statute_key": { "type": "string", "minLength": 3 },
          "실측표기": { "type": "string", "minLength": 1 },
          "정식명칭": { "type": "string" },
          "약칭": { "type": "string" },
          "법령ID": { "type": "string" },
          "법령구분": { "type": "string" },
          "소관": { "type": "string" },
          "공포번호": { "type": "string" },
          "공포일자": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "시행일자": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "출처URL": { "type": "string" },
          "검증상태": { "enum": ["정본대조", "미대조"] },
          "대조방법": { "type": "string", "minLength": 1 },
          "인용수": { "type": "integer", "minimum": 1 },
          "인용용어수": { "type": "integer", "minimum": 1 },
          "출현지구수": { "type": "integer", "minimum": 1 },
          "인용조문": { "type": "array", "items": { "type": "string" } },
          "표기변이수": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "statute_citations.json — 시행지침 → 상위법령 인용 간선",
  "type": "object",
  "required": ["meta", "statutes_needed", "citations"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "생성근거", "어휘학습", "인용수", "미해소수", "해소방법별",
        "법령수", "출처규약", "미해소_취급", "스크립트"
      ],
      "properties": {
        "인용수": { "type": "integer", "minimum": 1 },
        "미해소수": { "type": "integer", "minimum": 0 },
        "법령수": { "type": "integer", "minimum": 1 },
        "해소방법별": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "statutes_needed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["statute_key", "statute_name", "인용수", "표기변이"],
        "additionalProperties": false,
        "properties": {
          "statute_key": { "type": "string", "minLength": 3 },
          "statute_name": { "type": "string", "minLength": 1 },
          "인용수": { "type": "integer", "minimum": 0 },
          "표기변이": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "citation_id", "term", "term_id", "variant_index",
          "statute_key", "statute_name", "surface", "articles",
          "resolution", "districts", "quote"
        ],
        "additionalProperties": false,
        "properties": {
          "citation_id": { "type": "string", "pattern": "^C[0-9]{5}$" },
          "term": { "type": "string", "minLength": 1 },
          "term_id": { "type": "string", "pattern": "^T[0-9]{4,}$" },
          "variant_index": { "type": "integer", "minimum": 0 },
          "statute_key": { "type": "string", "minLength": 3 },
          "statute_name": { "type": "string", "minLength": 1 },
          "surface": { "type": "string", "minLength": 1 },
          "articles": { "type": "array", "items": { "type": "string" } },
          "resolution": { "enum": ["직접", "상대참조해소"] },
          "resolution_note": { "type": "string" },
          "districts": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[0-9]{5}[A-Z]{2}[0-9]{7}$" }
          },
          "quote": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

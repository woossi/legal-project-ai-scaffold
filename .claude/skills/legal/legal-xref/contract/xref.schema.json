{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "xref.schema.json",
  "title": "시행지침 조문 참조 레코드",
  "$comment": "원문 표기(surface·name_surface·quote)와 해소값(target·range)의 필드를 나눈다. 섞으면 원문 복원이 불가능해진다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "xrefs"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["생성근거", "스크립트", "문서수", "조문수", "참조수", "격리수",
                   "scope별", "kind별", "resolution별", "경계"],
      "properties": {
        "생성근거": {"type": "string"},
        "스크립트": {"type": "string"},
        "문서수": {"type": "integer", "minimum": 1},
        "지구번호_없는_문서": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "array", "items": {"type": "string"}}
          ]
        },
        "조문수": {"type": "integer", "minimum": 0},
        "조문헤딩_있는_문서수": {"type": "integer", "minimum": 0},
        "참조수": {"type": "integer", "minimum": 0},
        "격리수": {"type": "integer", "minimum": 0},
        "scope별": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "내부": {"type": "integer", "minimum": 0},
            "외부": {"type": "integer", "minimum": 0},
            "미판정": {"type": "integer", "minimum": 0}
          }
        },
        "kind별": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "법령": {"type": "integer", "minimum": 0},
            "법령조문": {"type": "integer", "minimum": 0},
            "별표": {"type": "integer", "minimum": 0},
            "별지·서식": {"type": "integer", "minimum": 0},
            "부칙": {"type": "integer", "minimum": 0},
            "내부조문": {"type": "integer", "minimum": 0},
            "내부표목": {"type": "integer", "minimum": 0},
            "외부문서": {"type": "integer", "minimum": 0},
            "범위": {"type": "integer", "minimum": 0},
            "준용": {"type": "integer", "minimum": 0}
          }
        },
        "resolution별": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "직접": {"type": "integer", "minimum": 0},
            "상대참조해소": {"type": "integer", "minimum": 0},
            "범위전개": {"type": "integer", "minimum": 0},
            "미해소": {"type": "integer", "minimum": 0}
          }
        },
        "relation별": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "참조": {"type": "integer", "minimum": 0},
            "준용": {"type": "integer", "minimum": 0}
          }
        },
        "법령정본_대조별": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "정본대조": {"type": "integer", "minimum": 0},
            "미대조": {"type": "integer", "minimum": 0},
            "미수록": {"type": "integer", "minimum": 0}
          }
        },
        "내부조문_후보다중": {"type": "integer", "minimum": 0},
        "어휘": {
          "type": "object",
          "additionalProperties": false,
          "required": ["정본_법령수", "학습_표기수", "어휘_총키수"],
          "properties": {
            "정본_법령수": {"type": "integer", "minimum": 0},
            "학습_표기수": {"type": "integer", "minimum": 0},
            "어휘_총키수": {"type": "integer", "minimum": 0}
          }
        },
        "경계": {"type": "string"},
        "격리_취급": {"type": "string"},
        "설명": {"type": "string"},
        "사유별": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^.+/.+/.+$": {"type": "integer", "minimum": 0}
          }
        },
        "후보다중수": {"type": "integer", "minimum": 0},
        "법령정본_미수록수": {"type": "integer", "minimum": 0}
      }
    },
    "xrefs": {"type": "array", "items": {"$ref": "#/definitions/xref"}}
  },
  "definitions": {
    "xref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xref_id", "dstrcAppnNo", "지구명", "지역", "source_file",
                   "line", "pos", "article_origin", "article_iri", "article_no",
                   "article_label", "surface", "name_surface", "scope",
                   "scope_basis", "kind", "relation", "resolution", "target",
                   "range", "quote"],
      "properties": {
        "xref_id": {"type": "string", "pattern": "^X[0-9]{6}$"},
        "dstrcAppnNo": {"type": "string", "pattern": "^[0-9]{5}[A-Z]{2}[0-9]{7}$"},
        "지구명": {"type": ["string", "null"]},
        "지역": {"type": "string", "enum": ["경기", "서울", "인천"]},
        "source_file": {"type": "string", "pattern": "^output/legal/markdown/"},
        "line": {"type": "integer", "minimum": 1},
        "pos": {"type": "integer", "minimum": 0},

        "article_origin": {
          "type": "string", "enum": ["조문헤딩", "문서레벨"],
          "$comment": "문서레벨은 조문 헤딩 밖의 참조다. 결손이 아니라 귀속 근거가 없다는 뜻이다"
        },
        "article_iri": {
          "type": ["string", "null"],
          "pattern": "^guidelineArticle/[0-9]{5}[A-Z]{2}[0-9]{7}/.+-[0-9]{2}$",
          "$comment": "kb-ontology mint_iri.guideline_article 과 같은 규약. 정본은 그쪽이다"
        },
        "article_no": {"type": ["string", "null"]},
        "article_label": {"type": ["string", "null"]},

        "surface": {"type": "string", "minLength": 1,
                    "$comment": "참조 표기 원문. 인용부호를 포함한다"},
        "name_surface": {"type": ["string", "null"],
                         "$comment": "참조 안의 대상명 표기 원문"},

        "scope": {"type": "string", "enum": ["내부", "외부", "미판정"]},
        "scope_basis": {
          "type": "string",
          "enum": ["인용부호법령", "인용부호문서", "인용부호표목", "어휘일치법령",
                   "상대참조", "본지침명시", "문서조문실재", "현재조문내",
                   "편장절한정", "문서표제일치", "편장절실재",
                   "편장절_대조불가", "선행법령없음_문서귀속",
                   "선행법령_비인접", "선행법령없음", "선행법령_어휘미포착",
                   "문서구분불가", "근거없음",
                   "준용대상표기없음"]
        },
        "kind": {
          "type": "string",
          "enum": ["법령", "법령조문", "별표", "별지·서식", "부칙",
                   "내부조문", "내부표목", "외부문서", "범위", "준용"],
          "$comment": "대상 유형이다. 준용은 준용 서술의 대상 표기를 못 찾은 경우에만 쓴다 — 관계로서의 준용은 relation 이 담는다"
        },
        "relation": {
          "type": "string", "enum": ["참조", "준용"],
          "$comment": "참조 표기가 준용 서술 안에 있으면 준용이다"
        },
        "resolution": {
          "type": "string",
          "enum": ["직접", "상대참조해소", "범위전개", "미해소"]
        },
        "resolution_note": {"type": "string"},

        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["statute_key", "statute_official", "master_status",
                       "articles", "annex", "form", "article_iri", "heading",
                       "후보수"],
          "properties": {
            "statute_key": {"type": ["string", "null"]},
            "statute_official": {
              "type": "string",
              "$comment": "법제처 정본 명칭. 미수록이면 빈 문자열이다 — 못 찾은 것을 찾은 것처럼 만들지 않는다"
            },
            "master_status": {
              "type": ["string", "null"],
              "enum": ["정본대조", "미대조", "미수록", null],
              "$comment": "관측값이다. 미수록은 statute_master 에 없다는 뜻, 미대조는 있으나 법제처 정본에 대조되지 않았다는 뜻이며 둘 다 미해소가 아니다"
            },
            "articles": {"type": "array", "items": {"type": "string"}},
            "annex": {"type": ["string", "null"], "pattern": "^별표[0-9]+$"},
            "form": {"type": ["string", "null"]},
            "article_iri": {
              "type": ["string", "null"],
              "pattern": "^guidelineArticle/[0-9]{5}[A-Z]{2}[0-9]{7}/.+-[0-9]{2}$"
            },
            "heading": {"type": ["string", "null"]},
            "후보수": {
              "type": ["integer", "null"], "minimum": 0,
              "$comment": "문서 안 동일 조번호 후보 수. 2 이상이면 article_iri 를 비운다"
            }
          }
        },

        "range": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["from", "to", "expanded", "expand_basis", "expand_fail"],
          "properties": {
            "from": {"type": "string"},
            "to": {"type": "string"},
            "expanded": {"type": "array", "items": {"type": "string"}},
            "expand_basis": {"type": ["string", "null"]},
            "expand_fail": {"type": ["string", "null"]}
          }
        },

        "quote": {
          "type": "string", "minLength": 1,
          "$comment": "근거 발췌. 참조 위치 기준이어야 한다 — 문장 앞부분을 잘라 담으면 뒤쪽 참조가 근거 밖으로 밀려난다"
        }
      }
    }
  }
}

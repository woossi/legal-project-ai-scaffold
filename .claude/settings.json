{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Glob",
      "Grep",
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Agent(Explore)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(git reset --hard)",
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git clean)",
      "Bash(git clean:*)",
      "Edit(output/legal/시행지침/**/*.hwp)",
      "Edit(output/legal/시행지침/**/*.pdf)",
      "Read(~/.claude/.deepseek.env)"
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS_MODE": "in-process",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "0"
  },
  "autoMemoryEnabled": true,
  "language": "korean",
  "teammateMode": "in-process",
  "effortLevel": "high",
  "enableArtifact": true,
  "enableAllProjectMcpServers": true
}
